.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Outputs
outputs/

# Assets (if they are generated, but we are providing them, so we might not ignore)
# However, if we were to generate assets, we would ignore them. Since we are providing SVGs, we keep them.
# But let's ignore any generated assets in case we generate more.
assets/*.generated.svg

# Miscellaneous
*.cfg
*.ini
*.cfg
*.ini